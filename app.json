{
  "expo": {
    "name": "WLYL Parent",
    "slug": "wlyl-parent-mobile",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wlylparent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.welearnyoulearn.parent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B5365A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.welearnyoulearn.parent",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5365A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B5365A",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/exams_chime.wav",
            "./assets/sounds/results_bells.wav",
            "./assets/sounds/fees_coin.wav",
            "./assets/sounds/absent_alert.wav",
            "./assets/sounds/message_ding.wav",
            "./assets/sounds/birthday_jingle.wav"
          ]
        }
      ],
      "expo-asset",
      "expo-sharing",
      ["expo-build-properties", { "android": { "enableMinifyInReleaseBuilds": true, "enableShrinkResourcesInReleaseBuilds": true } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3a98cfb-122d-4090-a208-2b1237d49031"
      }
    },
    "owner": "thindaam"
  }
}
